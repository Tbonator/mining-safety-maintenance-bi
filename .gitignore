# Secrets: never upload
.env

# Downloaded or generated data
data/raw/*
!data/raw/.gitkeep

# Python
__pycache__/
.venv/

# Airflow runtime files
airflow/logs/
airflow/config/airflow.cfg
.vscode/

# dbt generated files
dbt/**/target/
dbt/**/dbt_packages/
dbt/**/logs/

# Editor backup files and stray logs
*~
logs/